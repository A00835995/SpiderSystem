    "/compras/crearOrden": {
      "post": {
        "tags": ["Compras"],
        "summary": "Crear orden de compra",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "idProv": {
                  "type": "integer",
                  "description": "ID del proveedor",
                  "example": 1
                },
                "idPago": {
                  "type": "integer",
                  "description": "ID del método de pago",
                  "example": 1
                },
                "fechaPedido": {
                  "type": "string",
                  "format": "date",
                  "description": "Fecha de la orden (YYYY-MM-DD)",
                  "example": "2025-06-07"
                },
                "fechaEntrega": {
                  "type": "string",
                  "format": "date",
                  "description": "Fecha de entrega esperada (YYYY-MM-DD)",
                  "example": "2025-06-12"
                },
                "items": {
                  "type": "array",
                  "description": "Productos a ordenar",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ItemId": {
                        "type": "integer",
                        "description": "ID del artículo",
                        "example": 25
                      },
                      "ItemQuantity": {
                        "type": "integer",
                        "description": "Cantidad a ordenar",
                        "example": 1
                      },
                      "ItemPrice": {
                        "type": "number",
                        "format": "float",
                        "description": "Precio por unidad",
                        "example": 235.99
                      }
                    }
                  },
                  "example": [
                    {
                      "ItemId": 25,
                      "ItemQuantity": 1,
                      "ItemPrice": 235.99
                    }
                  ]
                }
              },
              "example": {
                "idProv": 1,
                "idPago": 1,
                "fechaPedido": "2025-06-07",
                "fechaEntrega": "2025-06-12",
                "items": [
                  {
                    "ItemId": 25,
                    "ItemQuantity": 1,
                    "ItemPrice": 235.99
                  }
                ]
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Orden creada correctamente",
            "schema": {
              "type": "object",
              "properties": {
                "ordenId": {
                  "type": "integer",
                  "example": 123
                },
                "mensaje": {
                  "type": "string",
                  "example": "Orden creada exitosamente"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos"
          },
          "500": {
            "description": "Error en el servidor"
          }
        }
      }
    },
